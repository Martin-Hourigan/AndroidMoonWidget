    <string name="zodiac_aries_description">Impulsive and direct; a moon for starting things rather than finishing them.</string>
    <string name="zodiac_taurus_description">Steady and sensory; associated with comfort, patience and holding ground.</string>
    <string name="zodiac_gemini_description">Restless and talkative; linked to curiosity, news and scattered attention.</string>
    <string name="zodiac_cancer_description">The Moon\'s home sign; inward, protective and strongly tidal in mood.</string>
    <string name="zodiac_leo_description">Expressive and warm; drawn to performance, generosity and being seen.</string>
    <string name="zodiac_virgo_description">Precise and practical; a moon for sorting, mending and paying attention to detail.</string>
    <string name="zodiac_libra_description">Balancing and social; concerned with fairness, harmony and other people.</string>
    <string name="zodiac_scorpio_description">Intense and private; associated with depth, secrecy and thorough endings.</string>
    <string name="zodiac_sagittarius_description">Expansive and restless; pulls toward travel, meaning and the bigger picture.</string>
    <string name="zodiac_capricorn_description">Disciplined and structural; a moon for long horizons and hard work.</string>
    <string name="zodiac_aquarius_description">Detached and inventive; drawn to systems, groups and unorthodox angles.</string>
    <string name="zodiac_pisces_description">Diffuse and imaginative; boundaries soften, intuition and rest come forward.</string>

