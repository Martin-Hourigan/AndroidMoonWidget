    <string name="sun_aries_description">Spring\'s opening push; associated with initiative, appetite and going first.</string>
    <string name="sun_taurus_description">Settled and sensory; a season for building slowly and enjoying what is already here.</string>
    <string name="sun_gemini_description">Quick and curious; associated with talk, variety and holding two things at once.</string>
    <string name="sun_cancer_description">Protective and homeward; concerned with family, memory and safe ground.</string>
    <string name="sun_leo_description">Warm and expressive; associated with confidence, generosity and being seen.</string>
    <string name="sun_virgo_description">Practical and exacting; a season for sorting, mending and useful work.</string>
    <string name="sun_libra_description">Weighing and sociable; concerned with fairness, beauty and other people.</string>
